<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Panel -->
    <entry name="icon" type="String">
      <default>preferences-system-symbolic</default>
    </entry>
    <entry name="showNetworkIndicator" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showVolumeIndicator" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showBatteryIndicator" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showNotificationIndicator" type="Bool">
      <default>true</default>
    </entry>

    <!-- Popup -->
    <entry name="tiles" type="StringList">
      <default>wifi,bluetooth,nightlight,dnd,airplane,powerprofile,microphone,kdeconnect,keepawake,darkmode,clipboard,colorpicker,screenshot,hotspot,vpn</default>
    </entry>
    <entry name="showSliders" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showMedia" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showDevices" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showPrintQueue" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showNotificationsTab" type="Bool">
      <default>true</default>
    </entry>
    <!-- 1 = Default, 2 = Large (0, the old Small, now shows as Default) -->
    <entry name="headerIconSize" type="Int">
      <default>1</default>
    </entry>
    <!-- 0 = Default, 1 = Thin -->
    <entry name="headerHeight" type="Int">
      <default>0</default>
    </entry>
    <!-- The header's ring: 0 = battery, 1 = CPU and RAM, 2 = GPU and VRAM, 3 = nothing -->
    <entry name="headerBadge" type="Int">
      <default>0</default>
    </entry>
    <!-- Remembered between runs -->
    <entry name="colorHistory" type="StringList">
      <default></default>
    </entry>
    <!-- Dark Mode tile without default light/dark global themes: what each side applies,
         updated with whatever was active before each switch. Empty means leave it as is. -->
    <entry name="lightColorScheme" type="String">
      <default>BreezeLight</default>
    </entry>
    <entry name="darkColorScheme" type="String">
      <default>BreezeDark</default>
    </entry>
    <entry name="lightPlasmaStyle" type="String">
      <default>default</default>
    </entry>
    <entry name="darkPlasmaStyle" type="String">
      <default></default>
    </entry>
    <entry name="lightIconTheme" type="String">
      <default>breeze</default>
    </entry>
    <entry name="darkIconTheme" type="String">
      <default></default>
    </entry>
    <entry name="animateClick" type="Bool">
      <default>true</default>
    </entry>
    <!-- Custom tile 1: commands run with sh when the tile is switched on / off -->
    <entry name="custom1Name" type="String">
      <default></default>
    </entry>
    <entry name="custom1Icon" type="String">
      <default>system-run-symbolic</default>
    </entry>
    <entry name="custom1OnCommand" type="String">
      <default></default>
    </entry>
    <entry name="custom1OffCommand" type="String">
      <default></default>
    </entry>
    <!-- Optional: exit code 0 means on; otherwise the last state set from the tile is kept -->
    <entry name="custom1StatusCommand" type="String">
      <default></default>
    </entry>
    <entry name="custom1On" type="Bool">
      <default>false</default>
    </entry>
    <!-- Custom tile 2: commands run with sh when the tile is switched on / off -->
    <entry name="custom2Name" type="String">
      <default></default>
    </entry>
    <entry name="custom2Icon" type="String">
      <default>system-run-symbolic</default>
    </entry>
    <entry name="custom2OnCommand" type="String">
      <default></default>
    </entry>
    <entry name="custom2OffCommand" type="String">
      <default></default>
    </entry>
    <!-- Optional: exit code 0 means on; otherwise the last state set from the tile is kept -->
    <entry name="custom2StatusCommand" type="String">
      <default></default>
    </entry>
    <entry name="custom2On" type="Bool">
      <default>false</default>
    </entry>
  </group>
</kcfg>
